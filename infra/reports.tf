# Weekly meetings report (Lab 5, was infra/reports.yml). EventBridge Scheduler and
# `make report-now` put a command on an SQS queue (with a dead-letter queue); report-builder
# (backend image, in the VPC, no NAT) reads PostgreSQL and writes reports/<week>.csv to S3 through
# a gateway endpoint; ObjectCreated starts report-mailer (outside the VPC), which sends the file
# through SES. Neither function calls the other.

data "aws_caller_identity" "current" {}

# The backend security group, which the database already accepts on 5432.
data "aws_security_group" "backend" {
  id = data.aws_cloudformation_stack.main.outputs["EcsSecurityGroup"]
}

data "aws_secretsmanager_secret_version" "db" {
  secret_id = var.db_secret_arn
}

locals {
  account_id     = data.aws_caller_identity.current.account_id
  reports_bucket = "${var.project_name}-reports-${local.account_id}"
}

# --- Storage ---------------------------------------------------------------------------------

# In CloudFormation the bucket name had to be built by hand to break a cycle (permission ->
# bucket ARN -> bucket -> notification -> permission). Here the bucket, the permission and the
# notification are three resources, and the references order them.
resource "aws_s3_bucket" "reports" {
  bucket = local.reports_bucket

  # Every report since Lab 5. The name forces replacement; a plan that would do it fails.
  lifecycle {
    prevent_destroy = true
  }
}

resource "aws_s3_bucket_public_access_block" "reports" {
  bucket = aws_s3_bucket.reports.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_ownership_controls" "reports" {
  bucket = aws_s3_bucket.reports.id

  rule {
    object_ownership = "BucketOwnerEnforced"
  }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "reports" {
  bucket = aws_s3_bucket.reports.id

  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

resource "aws_s3_bucket_lifecycle_configuration" "reports" {
  bucket = aws_s3_bucket.reports.id

  rule {
    id     = "ExpireReports"
    status = "Enabled"

    filter {
      prefix = "reports/"
    }

    expiration {
      days = 90
    }
  }
}

resource "aws_s3_bucket_policy" "reports" {
  bucket = aws_s3_bucket.reports.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Sid       = "DenyInsecureTransport"
      Effect    = "Deny"
      Principal = "*"
      Action    = "s3:*"
      Resource  = [aws_s3_bucket.reports.arn, "${aws_s3_bucket.reports.arn}/*"]
      Condition = { Bool = { "aws:SecureTransport" = "false" } }
    }]
  })
}

resource "aws_s3_bucket_notification" "reports" {
  bucket = aws_s3_bucket.reports.id

  lambda_function {
    lambda_function_arn = aws_lambda_function.mailer.arn
    events              = ["s3:ObjectCreated:*"]
    filter_prefix       = "reports/"
    filter_suffix       = ".csv"
  }

  # S3 tests the target when the notification is saved: the permission must exist first.
  depends_on = [aws_lambda_permission.mailer_s3]
}

# Free. Without it the builder's PutObject has no route out of the private subnets and hangs
# until the function times out.
resource "aws_vpc_endpoint" "s3" {
  vpc_id            = data.aws_security_group.backend.vpc_id
  service_name      = "com.amazonaws.${var.region}.s3"
  vpc_endpoint_type = "Gateway"
  route_table_ids   = var.private_route_table_ids
}

# --- Commands: queue and schedule ------------------------------------------------------------

resource "aws_sqs_queue" "report_requests_dlq" {
  name                      = "${var.project_name}-report-requests-dlq"
  message_retention_seconds = 1209600
  max_message_size          = 1048576
  sqs_managed_sse_enabled   = true
}

resource "aws_sqs_queue" "report_requests" {
  name = "${var.project_name}-report-requests"
  # 6 x the builder's 60 s timeout: a message must not reappear while an attempt still runs.
  visibility_timeout_seconds = 360
  max_message_size           = 1048576
  sqs_managed_sse_enabled    = true

  redrive_policy = jsonencode({
    deadLetterTargetArn = aws_sqs_queue.report_requests_dlq.arn
    maxReceiveCount     = 3
  })
}

# Role names were generated by CloudFormation. A role's name forces replacement, so they stay.
resource "aws_iam_role" "scheduler" {
  name = "spry-reports-SchedulerRole-ZchjjWmzj3WV"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "scheduler.amazonaws.com" }
      Action    = "sts:AssumeRole"
      Condition = { StringEquals = { "aws:SourceAccount" = local.account_id } }
    }]
  })
}

resource "aws_iam_role_policy" "scheduler" {
  name = "send-report-request"
  role = aws_iam_role.scheduler.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = "sqs:SendMessage"
      Resource = aws_sqs_queue.report_requests.arn
    }]
  })
}

resource "aws_scheduler_schedule" "weekly" {
  name                = "${var.project_name}-weekly-report"
  description         = "Every Monday 07:00 Kyiv time, ask for last week's report"
  schedule_expression = var.schedule_expression
  # Without it the cron runs in UTC and the report moves by an hour with daylight saving.
  schedule_expression_timezone = "Europe/Kyiv"
  state                        = "ENABLED"

  flexible_time_window {
    mode = "OFF"
  }

  target {
    arn      = aws_sqs_queue.report_requests.arn
    role_arn = aws_iam_role.scheduler.arn
    # week null: the builder takes the ISO week before the current one.
    input = "{\"week\": null, \"source\": \"schedule\"}"
  }
}

# --- report-builder: in the VPC, reads the database, writes the file -------------------------

resource "aws_cloudwatch_log_group" "builder" {
  name              = "/aws/lambda/${var.project_name}-report-builder"
  retention_in_days = 14
}

resource "aws_iam_role" "builder" {
  name               = "spry-reports-BuilderRole-oVnLteSaUYGU"
  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
}

# Network interfaces in the VPC and CloudWatch Logs.
resource "aws_iam_role_policy_attachment" "builder_vpc" {
  role       = aws_iam_role.builder.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole"
}

resource "aws_iam_role_policy" "builder" {
  name = "build-reports"
  role = aws_iam_role.builder.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect   = "Allow"
        Action   = "s3:PutObject"
        Resource = "${aws_s3_bucket.reports.arn}/reports/*"
      },
      {
        Effect = "Allow"
        Action = [
          "sqs:ReceiveMessage",
          "sqs:DeleteMessage",
          "sqs:GetQueueAttributes",
          "sqs:ChangeMessageVisibility",
        ]
        Resource = aws_sqs_queue.report_requests.arn
      },
    ]
  })
}

# The backend image with another entry point: it brings the models, the database code and
# build_weekly_report.
resource "aws_lambda_function" "builder" {
  function_name = "${var.project_name}-report-builder"
  package_type  = "Image"
  image_uri     = var.backend_image
  architectures = ["x86_64"]
  role          = aws_iam_role.builder.arn
  # PostgreSQL connect plus the query; well under a minute, with room for a slow start.
  timeout     = 60
  memory_size = 512

  image_config {
    entry_point       = ["python", "-m", "awslambdaric"]
    command           = ["app.reports.lambda_handler.handler"]
    working_directory = "/app"
  }

  vpc_config {
    subnet_ids         = var.private_subnet_ids
    security_group_ids = [data.aws_security_group.backend.id]
  }

  logging_config {
    log_format = "Text"
    log_group  = aws_cloudwatch_log_group.builder.name
  }

  environment {
    variables = {
      DB_HOST = var.db_host
      DB_PORT = "5432"
      DB_NAME = var.db_name
      DB_USER = var.db_user
      # Read at plan time: reading Secrets Manager at run time would need an interface endpoint
      # (~$7/month per AZ), since the function has no route to the internet. The password ends
      # up in the function's configuration and in the Terraform state (ADR 0007).
      DB_PASSWORD      = jsondecode(data.aws_secretsmanager_secret_version.db.secret_string)["password"]
      DB_SSLMODE       = "verify-full"
      REPORTS_BUCKET   = aws_s3_bucket.reports.bucket
      REPORT_TIMEZONE  = "Europe/Kyiv"
      REPORT_FAIL_WEEK = var.fail_week
    }
  }

  # The policies must be attached before the first invocation.
  depends_on = [aws_iam_role_policy_attachment.builder_vpc, aws_iam_role_policy.builder]
}

resource "aws_lambda_event_source_mapping" "builder_queue" {
  event_source_arn = aws_sqs_queue.report_requests.arn
  function_name    = aws_lambda_function.builder.arn
  batch_size       = 1

  # At most two builders at once: a burst of requests waits in the queue, not on the database.
  scaling_config {
    maximum_concurrency = 2
  }
}

# --- report-mailer: outside the VPC, reacts to the file, sends it through SES ----------------

data "aws_iam_policy_document" "lambda_assume" {
  statement {
    actions = ["sts:AssumeRole"]

    principals {
      type        = "Service"
      identifiers = ["lambda.amazonaws.com"]
    }
  }
}

resource "aws_cloudwatch_log_group" "mailer" {
  name              = "/aws/lambda/${var.project_name}-report-mailer"
  retention_in_days = 14
}

resource "aws_iam_role" "mailer" {
  name               = "spry-reports-MailerRole-WWb3nFwFds0W"
  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
}

resource "aws_iam_role_policy_attachment" "mailer_logs" {
  role       = aws_iam_role.mailer.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

resource "aws_iam_role_policy" "mailer" {
  name = "mail-reports"
  role = aws_iam_role.mailer.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      # Read only. A function triggered by uploads to reports/ that also wrote there would call
      # itself forever.
      {
        Effect   = "Allow"
        Action   = "s3:GetObject"
        Resource = "${aws_s3_bucket.reports.arn}/reports/*"
      },
      {
        Effect   = "Allow"
        Action   = ["ses:SendEmail", "ses:SendRawEmail"]
        Resource = "arn:aws:ses:${var.region}:${local.account_id}:identity/*"
      },
    ]
  })
}

# The code was inline (ZipFile) in the template; now it is a file next to the configuration.
data "archive_file" "mailer" {
  type        = "zip"
  source_file = "${path.module}/mailer/index.py"
  output_path = "${path.module}/.build/report-mailer.zip"
}

resource "aws_lambda_function" "mailer" {
  function_name    = "${var.project_name}-report-mailer"
  runtime          = "python3.12"
  handler          = "index.handler"
  architectures    = ["arm64"]
  role             = aws_iam_role.mailer.arn
  timeout          = 30
  memory_size      = 256
  filename         = data.archive_file.mailer.output_path
  source_code_hash = data.archive_file.mailer.output_base64sha256

  logging_config {
    log_format = "Text"
    log_group  = aws_cloudwatch_log_group.mailer.name
  }

  environment {
    variables = {
      SENDER     = "Spry reports <reports@${var.mail_domain}>"
      RECIPIENTS = join(",", var.recipients)
    }
  }

  depends_on = [aws_iam_role_policy_attachment.mailer_logs, aws_iam_role_policy.mailer]
}

resource "aws_lambda_permission" "mailer_s3" {
  statement_id   = "spry-reports-MailerInvokePermission-k1teifiz40MQ"
  action         = "lambda:InvokeFunction"
  function_name  = aws_lambda_function.mailer.function_name
  principal      = "s3.amazonaws.com"
  source_arn     = aws_s3_bucket.reports.arn
  source_account = local.account_id
}

# --- SES -------------------------------------------------------------------------------------

# Verified once the three DKIM CNAME records from the outputs exist in DNS.
resource "aws_sesv2_email_identity" "domain" {
  email_identity = var.mail_domain

  dkim_signing_attributes {
    next_signing_key_length = "RSA_2048_BIT"
  }
}

# SPF for our own domain instead of amazonses.com, so DMARC passes on SPF as well as DKIM.
# Until its MX and TXT records exist, SES falls back to amazonses.com.
resource "aws_sesv2_email_identity_mail_from_attributes" "domain" {
  email_identity         = aws_sesv2_email_identity.domain.email_identity
  mail_from_domain       = "mail.${var.mail_domain}"
  behavior_on_mx_failure = "USE_DEFAULT_VALUE"
}

# The SES sandbox delivers only to verified addresses; AWS emails a link to confirm this one.
resource "aws_sesv2_email_identity" "recipient" {
  email_identity = var.recipients[0]
}
