# Local defaults work without this file. Never commit real secrets.
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# Sign-in (Lab 3). Pick the Cognito prefix before creating the Google OAuth client.
COGNITO_DOMAIN_PREFIX=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local sign-in against the deployed pool: paste the output of `make auth-env`.
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=

# Weekly report (make deploy-reports). The domain needs the three DKIM records from the stack
# outputs; each recipient gets an SES confirmation email (sandbox).
REPORT_MAIL_DOMAIN=
REPORT_RECIPIENTS=

# Paste an agenda (make deploy-ai): budget alarm email; defaults to the first REPORT_RECIPIENTS.
BUDGET_EMAIL=
